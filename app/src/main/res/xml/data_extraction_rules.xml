<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude SQLCipher database files and journals from cloud backup -->
        <exclude domain="database" path="shellguard.db" />
        <exclude domain="database" path="shellguard.db-wal" />
        <exclude domain="database" path="shellguard.db-shm" />
        <exclude domain="database" path="." />

        <!-- Exclude attachments directory from cloud backup -->
        <exclude domain="file" path="vault_attachments" />

        <!-- Exclude EncryptedSharedPreferences from cloud backup -->
        <exclude domain="sharedpref" path="shellguard_prefs.xml" />
        <exclude domain="sharedpref" path="device_vault.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_file_pref__" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="shellguard.db" />
        <include domain="sharedpref" path="shellguard_prefs.xml" />
        <include domain="file" path="vault_attachments" />
    </device-transfer>
</data-extraction-rules>
