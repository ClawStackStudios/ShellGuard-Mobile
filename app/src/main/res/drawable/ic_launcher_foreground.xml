        <!-- Clam Pearl Core -->
        <path
            android:pathData="M 16, 15 m -3.5, 0 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0"
            android:fillColor="#CCE4048A" />

